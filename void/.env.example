# Contact form delivery (Resend). Without these the form returns a 503 and
# tells the sender to email directly, rather than faking a success state.
RESEND_API_KEY=
# Must be a sender address verified in your Resend account.
CONTACT_FROM=
# Required. Without it the form returns 503 rather than silently sending to the
# placeholder address in lib/site-data.ts.
CONTACT_TO=
