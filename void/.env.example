# Contact form delivery over SMTP.
#
# voidsec.sh already uses Zoho Mail (its MX and SPF records point at Zoho), so
# sending through Zoho needs no DNS changes and passes SPF as-is.
#
#   SMTP_HOST=smtp.zoho.com     (use smtp.zoho.eu if the account is in the EU DC)
#   SMTP_PORT=465
#   SMTP_USER=contact@voidsec.sh
#   SMTP_PASS=<app-specific password from Zoho, not the login password>
#   CONTACT_TO=contact@voidsec.sh
#
# Any other SMTP provider works without a code change.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where enquiries land. Required.
CONTACT_TO=
# Optional. Defaults to SMTP_USER. Most providers reject a From address that is
# not the authenticated mailbox or one of its verified aliases.
CONTACT_FROM=
